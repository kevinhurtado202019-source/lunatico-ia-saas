# Obligatorias. Si falta alguna, el servidor no arranca (ver LEEME.md).
MONGODB_URI=
JWT_SECRET=
CLAUDE_API_KEY=

# Pagos (Wompi). Sin las tres, /api/comprar responde 503 y el resto sigue igual.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Correo (verificación de cuenta y recuperación de contraseña), vía la API
# HTTP de Resend (no su relay SMTP: Railway bloquea los puertos 25/465/587).
# Sin las dos, las cuentas quedan verificadas de entrada y
# /api/olvide-password responde 503.
RESEND_API_KEY=
SMTP_FROM=

# Fotos reales en el chat (Serper.dev, resultados de Google Imágenes). Sin
# ella, la IA no ofrece la herramienta buscar_imagen y nunca la menciona.
SERPER_API_KEY=

# Generar, editar y probar ropa en imágenes con IA (fal.ai, modelos Flux/
# Flux Kontext/IDM-VTON): pedidos de algo inventado/artístico, cambiarle
# algo a una imagen existente (quitar fondo, cambiar un texto/nombre
# escrito en la imagen, etc.), o combinar de verdad la foto de una persona
# con la foto de una prenda para "probársela". Sin ella, la IA no ofrece
# las herramientas generar_imagen, editar_imagen ni probar_prenda y nunca
# las menciona. Se saca en fal.ai/dashboard/keys.
FAL_API_KEY=

# WhatsApp (WhatsApp Cloud API de Meta) como canal adicional para chatear.
# Sin las tres, ese canal queda desactivado y el resto sigue igual. El token
# y el phone ID salen de Meta for Developers > tu app > WhatsApp > API
# Setup; el verify token te lo inventas tú y es el mismo que pones al
# configurar el webhook ahí. Además, la cuenta de WhatsApp Business (WABA)
# tiene que estar suscrita a esta app -- ver POST /{waba-id}/subscribed_apps
# en la documentación de Meta, si no, los mensajes nunca llegan al webhook.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

PORT=3001
