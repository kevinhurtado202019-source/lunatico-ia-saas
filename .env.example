# Obligatorias. Si falta alguna, el servidor no arranca (ver LEEME.md).
MONGODB_URI=
JWT_SECRET=
CLAUDE_API_KEY=

# Pagos (Wompi). Sin las tres, /api/comprar responde 503 y el resto sigue igual.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Correo (verificación de cuenta y recuperación de contraseña). Sin las tres,
# las cuentas quedan verificadas de entrada y /api/olvide-password responde 503.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_PORT=587

PORT=3001
